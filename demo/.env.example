AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
# Optional direct route. An OpenRouter key is sufficient to access real Jev.
TYPESAFE_API_KEY=
VALUERANK_LLM_MODEL=openai/gpt-6-luna
# auto prefers OpenRouter when its key exists; otherwise uses TypeSafe.
VALUERANK_JEV_PROVIDER=auto
VALUERANK_OPENROUTER_JEV_MODEL=typesafe/jev-1.13
VALUERANK_JEV_MODEL=jev-1.13.0
